{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.stagelogic.co.kr"
        }
      ],
      "destination": "https://www.stagelogic.kr/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/digest/",
      "schedule": "0 23 * * 0-4"
    }
  ],
  "rewrites": [
    {
      "source": "/me/",
      "destination": "/work/index.html"
    }
  ]
}
